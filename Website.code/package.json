{
  "name": "alistair-sweeting-portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "build:site": "vite build && node add-cache-headers.js && node sync-static-assets.js",
    "deploy:s3": "npm run build:site && bash scripts/deploy-s3.sh",
