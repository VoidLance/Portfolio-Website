# Supabase Edge Functions Environment Variables
# These should be set in your Supabase project secrets, NOT in .env

# Required for helpdesk-reply and ticket-notifications functions
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Required for helpdesk-reply function (email sending)
RESEND_API_KEY=your_resend_api_key
HELPDESK_REPLY_TO_EMAIL=helpdesk@your-domain.com

# Security Notes:
# - Service role keys should ONLY be used in server-side functions
# - Service role keys should NEVER be exposed to client-side code
# - All secrets should be stored in Supabase project secrets
# - Never commit actual secrets to version control
